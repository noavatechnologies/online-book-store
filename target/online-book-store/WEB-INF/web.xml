<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         version="4.0">

    <display-name>Online Book Store</display-name>

    <servlet>
        <servlet-name>BookController</servlet-name>
        <servlet-class>com.noava.bookstore.controller.BookController</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>BookController</servlet-name>
        <url-pattern>/books</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

</web-app>

